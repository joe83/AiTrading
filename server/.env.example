# AI Trading Platform - Environment Configuration
# Copy this to .env and fill in your actual values

# =============================================================================
# Grok AI (xAI) Configuration
# =============================================================================
# Get your API key from https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_PRIMARY=grok-4.6
XAI_MODEL_FAST=grok-4.5

# =============================================================================
# MEXC Exchange (Crypto)
# =============================================================================
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET_KEY=your_mexc_secret_key_here
MEXC_BASE_URL=https://api.mexc.com
MEXC_WS_URL=wss://wbs.mexc.com/ws

# =============================================================================
# Alpaca Exchange (US Stocks)
# =============================================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Use paper trading URL for testing:
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_WS_URL=wss://stream.data.alpaca.markets

# =============================================================================
# IC Markets (Forex) - via cTrader Open API or MT5
# =============================================================================
IC_MARKETS_API_KEY=your_ic_markets_api_key_here
IC_MARKETS_ACCOUNT_ID=your_account_id_here

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://aitrading:aitrading_pass@localhost:5432/aitrading
DATABASE_MAX_CONNECTIONS=10

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WS_PORT=8081

# =============================================================================
# JWT Authentication (for mobile app)
# =============================================================================
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRY_HOURS=720

# =============================================================================
# Trading Configuration
# =============================================================================
# Mode: "auto" or "manual"
TRADING_MODE=manual

# Risk Management
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONCURRENT_POSITIONS=5
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0

# Analysis intervals (seconds)
ANALYSIS_INTERVAL_SECS=30
SENTIMENT_CHECK_INTERVAL_SECS=300

# =============================================================================
# Logging
# =============================================================================
RUST_LOG=info,ai_trading_server=debug
