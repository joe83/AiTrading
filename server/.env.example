# AI Trading Platform - Environment Configuration
# Copy this to .env and fill in your actual values

# =============================================================================
# Grok AI (xAI) Configuration
# =============================================================================
# Direct xAI API: https://console.x.ai
# SuperGrok proxy from docker-compose.prod.yml: http://grok-proxy:8585/v1
# The API Keys page can switch between these without editing this file.
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_PRIMARY=grok-4.6
XAI_MODEL_FAST=grok-4.5
GROK_PROXY_URL=http://grok-proxy:8585/v1
GROK_CONTROL_URL=http://grok-proxy:8586

# =============================================================================
# MEXC Exchange (Crypto)
# =============================================================================
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET_KEY=your_mexc_secret_key_here
MEXC_BASE_URL=https://api.mexc.com
MEXC_WS_URL=wss://wbs.mexc.com/ws

# =============================================================================
# Alpaca Exchange (US Stocks)
# =============================================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Use paper trading URL for testing:
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_WS_URL=wss://stream.data.alpaca.markets

# =============================================================================
# IC Markets (Forex) - via cTrader Open API or MT5
# =============================================================================
IC_MARKETS_API_KEY=your_ic_markets_api_key_here
IC_MARKETS_ACCOUNT_ID=your_account_id_here

# =============================================================================
# Binance Exchange (Crypto Spot & Futures)
# =============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# =============================================================================
# Bybit Exchange (Crypto Spot & Derivatives V5)
# =============================================================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://aitrading:aitrading_pass@localhost:5432/aitrading
DATABASE_MAX_CONNECTIONS=10

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_WS_PORT=8081

# =============================================================================
# JWT Authentication (for mobile app)
# =============================================================================
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRY_HOURS=720

# =============================================================================
# Trading Configuration
# =============================================================================
# Mode: "auto" or "manual"
TRADING_MODE=manual

# Risk Management
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=3.0
MAX_CONCURRENT_POSITIONS=5
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0

# Analysis intervals (seconds)
ANALYSIS_INTERVAL_SECS=30
SENTIMENT_CHECK_INTERVAL_SECS=300

# Sleepless X watcher. Queues review signals. Does not place orders.
WATCH_ENABLED=true
WATCH_INTERVAL_SECS=60
WATCH_HANDLES=elonmusk,realDonaldTrump
WATCH_MIN_CONFIDENCE=0.7
WATCH_MAX_POST_AGE_SECS=600

# =============================================================================
# Logging
# =============================================================================
RUST_LOG=info,ai_trading_server=debug
